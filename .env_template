# === LLM API Keys ===
OPENAI_API_KEY=sk-xxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxx
QWEN_API_KEY=sk-xxxxxxx
GEMINI_API_KEY=sk-xxxxxxx

# === Model Selection ===
# Options: gpt-4o (default, uses OPENAI_MODEL) | gpt-5 | gpt-5.5 | deepseek | qwen | gemini
MODEL_TYPE=qwen

# OpenAI-compatible endpoint (used when MODEL_TYPE is not deepseek/qwen/gemini)
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-5
# Optional: DOTENV_PATH=/abs/path/to/experiments/configs/case.env
# Unset = provider default.
# Thinking knobs are vendor-specific (env_config.thinking_api_style):
#   DeepSeek V4: default ENABLE_THINKING=false → thinking.type=disabled
#                (provider default is high-on; we opt out unless enabled)
#                ENABLE_THINKING=true + REASONING_EFFORT=low|high|max to opt in
#   Qwen3:       ENABLE_THINKING only → extra_body {enable_thinking: bool}
#   Other:       thinking fields are not sent
# ENABLE_THINKING=false
# REASONING_EFFORT=low
# MAX_TOKENS=16384

# === Solver Paths ===
CVC5_BINARY=./cvc/cvc5-Linux-x86_64-static/bin/cvc5
CVC4_BINARY=./cvc/cvc4_binary/cvc4-1.6-x86_64-linux-opt
VAMPIRE_BINARY=./vampire/vampire
# Serial dual Vampire (one process at a time; tip → portfolio → optional integer)
# VAMPIRE_SERIAL_DUAL=on
#   Vampire Mate only: also sets config LLM_SERIAL_PROVE_BUDGET so LLM wall
#   drops HTTP retries before usefulness and keeps a 6s prove floor (3×2s).
#   CVC Mate never sets that flag → paper LLM budget unchanged.
# VAMPIRE_SERIAL_TIP_S=8
# VAMPIRE_SERIAL_SCHEME_TIP_S=5
# VAMPIRE_SERIAL_SCHEME_EXTRA_S=5   # scheme wall = PROVE_TIMEOUT_S + this (10+5=15)
# VAMPIRE_INTEGER_BOOST=on          # Int/LIA: pre-reserve int arm from portfolio
# VAMPIRE_INTEGER_BOOST_S=8         # main-path integer reserve / cap
# VAMPIRE_INTEGER_BOOST_SCHEME_S=5  # scheme integer reserve / cap
# VAMPIRE_INTEGER_BOOST_MIN_REMAIN_S=6  # only if not pre-reserved
# VAMPIRE_INTEGER_BOOST_ON_SCHEME=on
# VAMPIRE_SERIAL_DUAL=off  # v2 baseline: single induction_portfolio

# === Network Proxy (optional) ===
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# === Runtime Parameters (optional, defaults shown) ===
# MAX_ATTEMPTS_PER_PROMPT=3
# DEFAULT_CVC_TIMEOUT=60
# RETRY_CVC_TIMEOUT=100  # unused while the post-LLM-exhaustion retry is commented out
# COMBINED_CVC_TIMEOUT=60
# MAX_RECURSION_DEPTH=3
# TASK_TIMEOUT=1200
# PROMPT_MODE_SEED=  # optional; if set, both-kind prompt sampling is reproducible

# Cross-attempt inheritance (optional; both default on)
# LEMMA_LIBRARY=on       # proved lemmas as axioms + library block in the prompt
# LEMMA_LIBRARY_LOCAL=on # usefulness-timeout harvest of directly proved lemmas (role=local)
# USEFULNESS_HARVEST_DELAY_S=2  # start A⊢c_i only if usefulness still running
# HARVEST_RETRY_TIMEOUT=2       # prove G after local harvest; not the 60s usefulness budget
# OBLIGATION_TREE=on     # last well-formed split tree in the prompt / json

# PCR / GSE ablation (optional; most default on)
# PROMPT_ADVICE=on           # LAST ATTEMPT TRIGGER/BRIDGE/GENERALIZE
# PROBLEM_PROFILER=off       # GSE structure facts in lemma prompts
# INDUCTION_SCHEME=off       # structural/measure scheme obligations
# UNPROVED_NOT_INVALID=on    # failed useful subgoals are unproved, not invalid

