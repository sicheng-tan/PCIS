.env
.DS_Store

# Case-study experiments: configs contain secrets; ignore result trees, keep top-level summary CSVs
experiments/configs/*.env
experiments/results/**
!experiments/results/.gitkeep
!experiments/results/*.csv

# Local AI / IDE metadata
.codex/
.cursor/
.claude/
.idea/
.vscode/

# Generated slide decks and their inspection artifacts
.codex_artifacts/
*.pptx
*.pptx.inspect.ndjson

__pycache__/
*.pyc

# cvc5 static SDK extras (keep only bin/cvc5)
cvc/cvc5-Linux-x86_64-static/include/
cvc/cvc5-Linux-x86_64-static/lib/
cvc/cvc5-Linux-x86_64-static/licenses/
cvc/cvc5-Linux-x86_64-static/AUTHORS
cvc/cvc5-Linux-x86_64-static/COPYING

# Local paper drafts and submission templates (not version-controlled)
/paper/
