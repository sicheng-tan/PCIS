# Shared runtime knobs (same across PCR / GSE / PCIS ablations and case studies).
# Copy to shared.env (gitignored via experiments/configs/*.env).
# Loaded before the experiment-specific env; experiment env can still override.
#
# These are not paper ablation differentiators — code defaults match the values below
# when this file is absent.

# Default off: prose INVALID_GOAL can hard-stop. Set on to require solver-checked CE_SMT.
LLM_INVALID_CE_VERIFY=off
# Extra lemma-generation round after CE_SMT fails check (same attempt; only if VERIFY=on).
LLM_INVALID_CE_RETRIES=0
# Default on: LLM INVALID_GOAL early-stops the child only (kind=stopped); no hard INVALID write-back.
LLM_INVALID_ONLY_STOP=on

# Child LLM attempt budget (0 = same 2N as root at every depth).
CHILD_LLM_ATTEMPTS=6
# Extra LLM calls after a format parse failure; same attempt (not HTTP retries).
LLM_PARSE_RETRIES=2
# Extra generation after static screen kept=0; same attempt, not mixed with parse retries.
LLM_SCREEN_RETRIES=1
