# Simple / case-study config. Copy to case.env and fill in API keys.
# Used for small local runs (experiments/cases/, single-task, or quick smoke tests).
# Main ablation templates: ablation_{pcr,gse,pcis}.env.example
# Fallback load path when DOTENV_PATH is unset: experiments/configs/case.env

# === LLM ===
OPENAI_API_KEY=sk-xxxxxxx
OPENAI_API_BASE=https://api.example.com/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Flash
MODEL_TYPE=deepseek-v4-flash
ENABLE_THINKING=false
# MAX_TOKENS=8192

# Optional HTTP(S) proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# === Solver Paths ===
CVC5_BINARY=./cvc/cvc5-Linux-x86_64-static/bin/cvc5
CVC4_BINARY=./cvc/cvc4_binary/cvc4-1.6-x86_64-linux-opt
VAMPIRE_BINARY=./vampire/vampire

# === Runtime (serial / small runs) ===
MAX_ATTEMPTS_PER_PROMPT=3
DEFAULT_CVC_TIMEOUT=60
COMBINED_CVC_TIMEOUT=60
MAX_RECURSION_DEPTH=3
TASK_TIMEOUT=1200
MAX_PARALLEL_TASKS=1

# Problem copies: experiments/cases/
# Outputs: experiments/results/<timestamp>_cases/

# === PCR / GSE (full method on for smoke tests) ===
LEMMA_LIBRARY=on
OBLIGATION_TREE=on
INVALID_LEMMAS=on
LEMMA_LIBRARY_LOCAL=on
USEFULNESS_HARVEST_DELAY_S=2
HARVEST_RETRY_TIMEOUT=2
ROOT_FINISH_PROVE_TIMEOUT=120
ANCESTOR_CYCLE_FILTER=on
ANCESTOR_PROMPT=on
UNPROVED_NOT_INVALID=on
SUBGOAL_SAT_ABORT=on
LEMMA_DEFINED_SYMBOLS=on
LEMMA_FILTER_DROP=on
LEMMA_WELLFORMED_CHECK=on

PROBLEM_PROFILER=on
PROBLEM_PROFILER_MIN_ATTEMPT=2
PROBLEM_PROFILER_TRIGGER=after_useless
INDUCTION_SCHEME=on
INDUCTION_SCHEME_MODE=both
INDUCTION_SCHEME_TRIGGER=after_useless
INDUCTION_SCHEME_GOAL_GATE=on
INDUCTION_SCHEME_PROMPT=on
INDUCTION_SCHEME_NEST=cross_sort

LLM_INVALID_ONLY_STOP=on
LLM_INVALID_CE_VERIFY=off
LLM_INVALID_CE_RETRIES=0
CHILD_LLM_ATTEMPTS=6
LLM_PARSE_RETRIES=2
LLM_SCREEN_RETRIES=1
# SKIP_PROBLEMS_FILE=experiments/configs/skip_nontheorems.txt
