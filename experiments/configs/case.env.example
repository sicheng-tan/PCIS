# Case-study config template. Copy to case.env and fill in API keys.
# Paper default model: Qwen3-235B-instruct (id qwen3-235b-a22b-instruct-2507).
# Use an OpenAI-compatible API base; do not set MODEL_TYPE=qwen
# (that path forces OpenRouter).

# === LLM ===
OPENAI_API_KEY=sk-xxxxxxx
OPENAI_API_BASE=https://api.example.com/v1
OPENAI_MODEL=qwen3-235b-a22b-instruct-2507
MODEL_TYPE=qwen3
# Qwen3 OpenAI-compat: only ENABLE_THINKING → extra_body.enable_thinking
# (REASONING_EFFORT is DeepSeek-V4-only and ignored here)
# ENABLE_THINKING=false
# MAX_TOKENS=8192

# Optional HTTP(S) proxy (set if your network requires one)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# === Solver Paths ===
CVC5_BINARY=./cvc/cvc5-Linux-x86_64-static/bin/cvc5
CVC4_BINARY=./cvc/cvc4_binary/cvc4-1.6-x86_64-linux-opt
VAMPIRE_BINARY=./vampire/vampire

# === Paper runtime (case study reuses the paper budgets) ===
MAX_ATTEMPTS_PER_PROMPT=3
DEFAULT_CVC_TIMEOUT=60
COMBINED_CVC_TIMEOUT=60
MAX_RECURSION_DEPTH=3
TASK_TIMEOUT=1200
MAX_PARALLEL_TASKS=1

# === Case-study I/O ===
# Problem copies: experiments/cases/
# Run outputs: experiments/results/<timestamp>_cases/

# === PCR / GSE (case study defaults: all on) ===
LEMMA_LIBRARY=on
OBLIGATION_TREE=on
# off | on (hard+soft, LAST ATTEMPT) | paper (LLM4Ind hard + all useless groups).
INVALID_LEMMAS=on
LEMMA_LIBRARY_LOCAL=on
USEFULNESS_HARVEST_DELAY_S=2
HARVEST_RETRY_TIMEOUT=2
PROBLEM_PROFILER=off
PROBLEM_PROFILER_MIN_ATTEMPT=1
PROBLEM_PROFILER_TRIGGER=always
UNPROVED_NOT_INVALID=on
SUBGOAL_SAT_ABORT=on
LEMMA_DEFINED_SYMBOLS=on
LEMMA_FILTER_DROP=on
# Extra LLM calls after a format parse failure; same attempt (not HTTP retries).
# Extra generation after static screen kept=0; same attempt, not mixed with parse retries.
# Optional: skip known non-theorems (one path per line).
# SKIP_PROBLEMS_FILE=experiments/configs/skip_nontheorems.txt
